; EMBERBOUND Stage B3 — complete project, Godot 4.7.2
config_version=5

[application]
config/name="EMBERBOUND: The Last Hour — Stage B3"
run/main_scene="res://scenes/forest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.025, 0.06, 1)

[physics]
common/physics_interpolation=true
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="Environment"
2d_physics/layer_2="Knight"
2d_physics/layer_3="Shadow"

